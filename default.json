{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate config for our Craft CMS / PHP projects",
  "extends": ["config:recommended", ":dependencyDashboard", ":timezone(Europe/Rome)"],
  "enabledManagers": ["composer"],
  "rangeStrategy": "update-lockfile",
  "schedule": ["before 9am on monday"],
  "prConcurrentLimit": 3,
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "One weekly PR with all minor/patch updates (Craft + plugins)",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Craft and plugins (minor/patch)",
      "groupSlug": "craft-minor-patch"
    },
    {
      "description": "Major updates (e.g. Craft 5 → 6) only on demand from the Dependency Dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "schedule": ["at any time"]
  },
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on the first day of the month"]
  }
}
